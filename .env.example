# Copy to api/.env and fill in values
GEMINI_API_KEY=
HF_TOKEN=
USE_LLM=true
EAGER_LOAD_MODELS=false

# Enhanced Model Configuration
MODEL_TEXT=mrm8488/bert-tiny-finetuned-fake-news-detection
MODEL_TEXT_ENHANCED=roberta-base-openai-detector
MODEL_IMAGE_CAPTION=Salesforce/blip-image-captioning-base
MODEL_IMAGE_AI=dima806/deepfake_vs_real_face_detection
MODEL_AUDIO=facebook/wav2vec2-base
MODEL_ZERO_SHOT=facebook/bart-large-mnli

# Model Features
USE_IMAGE_AI_CLASSIFIER=true
USE_ENSEMBLE=false
ZERO_SHOT_CATEGORIES=propaganda,satire,clickbait,conspiracy,real news

# Performance & Detection Settings
DEFAULT_CONFIDENCE_THRESHOLD=50
CACHE_ENABLED=true
CACHE_TTL_HOURS=24
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30
ML_TIMEOUT_SECONDS=90
URL_FETCH_TIMEOUT_SECONDS=15

# CORS Settings
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Database Configuration
# For SQLite (default): sqlite:///detections.db
# For PostgreSQL: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=sqlite:///detections.db
ASYNC_DATABASE_URL=sqlite+aiosqlite:///detections.db
USE_ASYNC_DB=false

# Celery Configuration (for async ML workers)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_BACKEND_URL=redis://localhost:6379/1
ENVIRONMENT=development
