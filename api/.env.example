# Optional: Google Gemini for human-readable explanations
GEMINI_API_KEY=

# Optional: Hugging Face token for gated models
HF_TOKEN=

# Text classification model (Hugging Face)
MODEL_TEXT=mrm8488/bert-tiny-finetuned-fake-news-detection

# Image captioning model (caption -> text pipeline)
MODEL_IMAGE_CAPTION=Salesforce/blip-image-captioning-base

# AI-generated image classifier (free HF model)
MODEL_IMAGE_AI=umm-maybe/AI-image-detector
USE_IMAGE_AI_CLASSIFIER=true

# SQLite database path (default: api/detections.db)
# DATABASE_URL=sqlite:///./detections.db

# Use Gemini for explanations (true/false) — set false for 100% free local mode
USE_LLM=false

# Load ML models at API startup
EAGER_LOAD_MODELS=false

# Result cache (same content within TTL returns instantly)
CACHE_ENABLED=true
CACHE_TTL_HOURS=24

# Rate limit per IP (requests per minute)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30

# Timeouts (seconds)
ML_TIMEOUT_SECONDS=90
URL_FETCH_TIMEOUT_SECONDS=15

# Default flag threshold (%)
DEFAULT_CONFIDENCE_THRESHOLD=50

# Max upload size for images (bytes, default 5MB)
MAX_IMAGE_BYTES=5242880

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

GEMINI_MODEL=gemini-1.5-flash
